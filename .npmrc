; PNPM Configuration for Next.js 16 Project
; Generated: 2026-04-06

# Package management
shamefully-hoist=false
prefer-workspace-packages=true
lockfile-only=false

# Performance
fetch-timeout=60000
fetch-retries=3

# Compatibility
engine-strict=true
auto-install-peers=true

# Security
registry=https://registry.npmjs.org/
